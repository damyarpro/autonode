# Everything here is optional. With an empty environment the whole funnel still
# runs: channels record their messages instead of delivering them, copy comes
# from templates, and checkout is a local mock.

PORT=8787
HOST=127.0.0.1
# Must be reachable from the internet before registering the Telegram webhook.
PUBLIC_URL=http://127.0.0.1:8787
DB_FILE=data/autonode.db

# --- Telegram (the one channel that goes live for real) ------------------
# Token from @BotFather. Keep it out of git.
TELEGRAM_BOT_TOKEN=
# Fixed secret path segment for the webhook. Generate once:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# --- Optional: Claude writes the outreach copy instead of templates ------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional: require signed payloads on POST /api/webhooks/:channel ----
WEBHOOK_SIGNING_SECRET=

# Signs the mock checkout so only a confirmation this server issued is
# accepted on POST /api/webhooks/payment. Random per boot when empty, which
# is safe by default and only means a checkout link does not survive a
# restart. Set it to keep links valid across restarts.
CHECKOUT_SIGNING_SECRET=

# --- Nurture pacing ------------------------------------------------------
# Multiplies every sequence delay. 1 is real time; 0 fires every step at once.
SEQUENCE_SPEED=1
WORKER_INTERVAL_MS=15000
WORKER_ENABLED=true

# Share of each payment the growth loop puts back into ads and testing.
GROWTH_REINVEST_RATE=0.27

# --- Optional: ElevenLabs writes the voice-over audio ---------------------
# With no key a voice job returns a timed, speakable script instead of audio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_API_URL=

# --- Optional: Higgsfield renders the ad video ---------------------------
# With no key a video job returns a shot-by-shot storyboard instead of a file.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_API_URL=
# HIGGSFIELD_MODEL=
HIGGSFIELD_POLL_MS=3000
HIGGSFIELD_POLL_ATTEMPTS=20
# Where rendered audio is written. Inside data/, which git ignores.
MEDIA_DIR=data/media

# --- Optional: Vapi actually dials the sales call ------------------------
# With no key the call brief is still written; only the dialling is simulated.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# VAPI_API_BASE=
# Country code for a number a lead wrote the local way (09123456789). 98 is Iran.
DEFAULT_CALLING_CODE=98
# Secret path segment for the end-of-call report Vapi posts back. Random per
# boot when empty, which means no request can reach the handler — set it, then
# paste the path GET /api/health reports into Vapi's server URL. Generate once:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VAPI_WEBHOOK_SECRET=
# Shorter than this and a completed call is not treated as a conversation.
CALL_MIN_CONVERSATION_SECONDS=30
# The message type that carries the report; override if Vapi renames it.
VAPI_REPORT_MESSAGE_TYPE=end-of-call-report

# --- Meetings and follow-up ---------------------------------------------
# The window the slot finder offers, in the owner's local time.
CALL_HOURS_START=10:00
CALL_HOURS_END=18:00
CALL_SLOT_MINUTES=30
# Minutes east of UTC for those hours. 210 is Tehran.
CALL_UTC_OFFSET_MINUTES=210
# Minutes before a meeting to send each reminder.
CALL_REMINDER_OFFSETS=1440,60
# Days after delivery before the referral ask goes out.
REFERRAL_ASK_DAYS=7

# --- Optional: publish for real to the other four channels ---------------
# With none of these set the channel records the piece and delivers nothing.
# Each one also needs a destination in the business profile (#/business),
# otherwise the publish fails with target:required. Shared timeout:
CHANNEL_TIMEOUT_MS=15000

# LinkedIn — the only one of the four that can publish plain text.
# Needs a verified Company Page and approved Community Management API access.
LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_API_BASE=https://api.linkedin.com/rest
# LinkedIn retires an API version after about a year; bump this when it 400s.
LINKEDIN_API_VERSION=202601
LINKEDIN_VISIBILITY=PUBLIC
LINKEDIN_AUTHOR_TYPE=organization

# Instagram — needs a Business/Creator account on a Facebook Page and App
# Review for instagram_content_publish. Cannot post text alone: a piece with
# no public image or video link fails with instagram:needs_media.
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_API_BASE=https://graph.facebook.com/v21.0
INSTAGRAM_VIDEO_TYPE=REELS
INSTAGRAM_POLL_MS=3000
INSTAGRAM_POLL_ATTEMPTS=10

# YouTube — needs the Data API enabled and, for the upload scope, a Google
# audit. A script is not a video: no video link fails with youtube:needs_video.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Or a short-lived token on its own:
YOUTUBE_ACCESS_TOKEN=
# New uploads stay private unless you say otherwise, so a worker pass cannot
# publish to the world by accident.
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22
YOUTUBE_MAX_UPLOAD_BYTES=134217728
YOUTUBE_UPLOAD_TIMEOUT_MS=120000

# Website — your own endpoint, so nothing to be approved for. The POST is
# signed the same way the inbound webhook is verified.
WEBSITE_PUBLISH_URL=
# Falls back to WEBHOOK_SIGNING_SECRET when empty.
WEBSITE_SIGNING_SECRET=
WEBSITE_SIGNATURE_HEADER=x-signature
WEBSITE_PUBLISH_TOKEN=

# --- Optional: password-protect the app and the API ----------------------
# Leave both of these empty and authentication stays OFF: no login screen, no
# guard, exactly the behaviour this repo has always had on 127.0.0.1. Set one
# of them and every API route except /api/health, /api/auth/*, the machine-
# called POST /api/webhooks/* and the mock GET /api/checkout/page needs a
# session.
# Plain password — hashed with scrypt at boot and never written anywhere.
APP_PASSWORD=
# Or a pre-computed salt:hash, so the password itself never sits in a file:
#   node --import tsx -e "import('./server/auth.ts').then(m=>console.log(m.makeCredential('your password')))"
# APP_PASSWORD_HASH wins over APP_PASSWORD when both are set.
APP_PASSWORD_HASH=
# HMAC key for session tokens. Random per boot when empty, which signs everyone
# out on restart; set it to keep sessions across a restart of the process.
SESSION_SECRET=
# How long a session stays valid.
SESSION_TTL_HOURS=12

# --- Single-origin deployment ------------------------------------------
# Serve the built app (dist/) from the API so both halves share one origin.
# That is what makes the session cookie work; leave it off in development,
# where Vite serves the app and proxies /api.
SERVE_STATIC=false
STATIC_DIR=dist
