# Everything here is optional. With an empty environment the whole funnel still
# runs: channels record their messages instead of delivering them, copy comes
# from templates, and checkout is a local mock.

PORT=8787
HOST=127.0.0.1
# Must be reachable from the internet before registering the Telegram webhook.
PUBLIC_URL=http://127.0.0.1:8787
DB_FILE=data/autonode.db

# --- Telegram (the one channel that goes live for real) ------------------
# Token from @BotFather. Keep it out of git.
TELEGRAM_BOT_TOKEN=
# Fixed secret path segment for the webhook. Generate once:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# --- Optional: Claude writes the outreach copy instead of templates ------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional: require signed payloads on POST /api/webhooks/:channel ----
WEBHOOK_SIGNING_SECRET=

# --- Nurture pacing ------------------------------------------------------
# Multiplies every sequence delay. 1 is real time; 0 fires every step at once.
SEQUENCE_SPEED=1
WORKER_INTERVAL_MS=15000
WORKER_ENABLED=true

# Share of each payment the growth loop puts back into ads and testing.
GROWTH_REINVEST_RATE=0.27

# --- Optional: ElevenLabs writes the voice-over audio ---------------------
# With no key a voice job returns a timed, speakable script instead of audio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_API_URL=

# --- Optional: Higgsfield renders the ad video ---------------------------
# With no key a video job returns a shot-by-shot storyboard instead of a file.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_API_URL=
# HIGGSFIELD_MODEL=
HIGGSFIELD_POLL_MS=3000
HIGGSFIELD_POLL_ATTEMPTS=20
# Where rendered audio is written. Inside data/, which git ignores.
MEDIA_DIR=data/media

# --- Optional: Vapi actually dials the sales call ------------------------
# With no key the call brief is still written; only the dialling is simulated.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# VAPI_API_BASE=

# --- Meetings and follow-up ---------------------------------------------
# The window the slot finder offers, in the owner's local time.
CALL_HOURS_START=10:00
CALL_HOURS_END=18:00
CALL_SLOT_MINUTES=30
# Minutes east of UTC for those hours. 210 is Tehran.
CALL_UTC_OFFSET_MINUTES=210
# Minutes before a meeting to send each reminder.
CALL_REMINDER_OFFSETS=1440,60
# Days after delivery before the referral ask goes out.
REFERRAL_ASK_DAYS=7

# --- Optional: password-protect the app and the API ----------------------
# Leave both of these empty and authentication stays OFF: no login screen, no
# guard, exactly the behaviour this repo has always had on 127.0.0.1. Set one
# of them and every API route except /api/health, /api/auth/*, the machine-
# called POST /api/webhooks/* and the mock GET /api/checkout/page needs a
# session.
# Plain password — hashed with scrypt at boot and never written anywhere.
APP_PASSWORD=
# Or a pre-computed salt:hash, so the password itself never sits in a file:
#   node --import tsx -e "import('./server/auth.ts').then(m=>console.log(m.makeCredential('your password')))"
# APP_PASSWORD_HASH wins over APP_PASSWORD when both are set.
APP_PASSWORD_HASH=
# HMAC key for session tokens. Random per boot when empty, which signs everyone
# out on restart; set it to keep sessions across a restart of the process.
SESSION_SECRET=
# How long a session stays valid.
SESSION_TTL_HOURS=12

# --- Single-origin deployment ------------------------------------------
# Serve the built app (dist/) from the API so both halves share one origin.
# That is what makes the session cookie work; leave it off in development,
# where Vite serves the app and proxies /api.
SERVE_STATIC=false
STATIC_DIR=dist
